# SFU address in any scheme, may include a reverse-proxy path:
# https://host/livekit, wss://host or http://localhost:7880
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Display server for the http sink, see docs/http-sink.md. Token: random, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
HTTP_SINK_URL=https://display.example.com/events
HTTP_SINK_TOKEN=

# Transcript UI (../livekit-transcript-ui): the livekit source posts {url}/sessions/<id>
# to the room chat. Unset: the chat message has no link
TRANSCRIPT_VIEW_URL=http://localhost:5173
